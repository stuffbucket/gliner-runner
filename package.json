{
  "name": "gliner-runner",
  "version": "0.3.1",
  "private": true,
  "description": "Local HTTP runner for GLiNER-family models",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "check": "pnpm -r --filter './packages/*' run check",
    "site:dev": "pnpm --filter @gliner-runner/site run dev",
    "site:build": "pnpm --filter @gliner-runner/site run build",
    "package:onnx-runtime": "node scripts/package-onnx-runtime.mjs",
    "verify:onnx-runtime": "node scripts/verify-onnx-runtime.mjs"
  }
}
