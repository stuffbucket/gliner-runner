{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "gliner-runner",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/onnx-runner/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "src/gliner_runner/__init__.py"
        },
        {
          "type": "generic",
          "path": "Dockerfile"
        }
      ]
    }
  }
}
