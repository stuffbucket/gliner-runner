{
  "components": {
    "schemas": {
      "BackendCapabilities": {
        "additionalProperties": false,
        "properties": {
          "backend": {
            "$ref": "#/components/schemas/BackendName"
          },
          "devices": {
            "items": {
              "type": "string"
            },
            "title": "Devices",
            "type": "array",
            "uniqueItems": true
          },
          "dynamic_batching": {
            "title": "Dynamic Batching",
            "type": "boolean"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/InferenceOperation"
            },
            "title": "Operations",
            "type": "array",
            "uniqueItems": true
          },
          "precision_profiles": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/PrecisionProfile"
            },
            "title": "Precision Profiles",
            "type": "array",
            "uniqueItems": true
          },
          "precisions": {
            "items": {
              "$ref": "#/components/schemas/Precision"
            },
            "title": "Precisions",
            "type": "array",
            "uniqueItems": true
          },
          "validated_models": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Validated Models",
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "backend",
          "operations",
          "precisions",
          "devices",
          "dynamic_batching"
        ],
        "title": "BackendCapabilities",
        "type": "object"
      },
      "BackendName": {
        "enum": [
          "pytorch",
          "mlx",
          "onnx"
        ],
        "title": "BackendName",
        "type": "string"
      },
      "BatchRequest": {
        "additionalProperties": false,
        "properties": {
          "requests": {
            "items": {
              "$ref": "#/components/schemas/InferenceRequest"
            },
            "maxItems": 256,
            "minItems": 1,
            "title": "Requests",
            "type": "array"
          }
        },
        "required": [
          "requests"
        ],
        "title": "BatchRequest",
        "type": "object"
      },
      "BatchResponse": {
        "additionalProperties": false,
        "properties": {
          "responses": {
            "items": {
              "$ref": "#/components/schemas/InferenceResponse"
            },
            "title": "Responses",
            "type": "array"
          }
        },
        "required": [
          "responses"
        ],
        "title": "BatchResponse",
        "type": "object"
      },
      "ClassificationSchema": {
        "additionalProperties": false,
        "properties": {
          "constraints": {
            "default": [],
            "items": {
              "additionalProperties": {
                "$ref": "#/components/schemas/JsonValue"
              },
              "type": "object"
            },
            "title": "Constraints",
            "type": "array"
          },
          "kind": {
            "const": "classification",
            "default": "classification",
            "title": "Kind",
            "type": "string"
          },
          "tasks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ClassificationTask"
            },
            "minProperties": 1,
            "title": "Tasks",
            "type": "object"
          }
        },
        "required": [
          "tasks"
        ],
        "title": "ClassificationSchema",
        "type": "object"
      },
      "ClassificationTask": {
        "additionalProperties": false,
        "properties": {
          "activation": {
            "default": "auto",
            "enum": [
              "auto",
              "sigmoid",
              "softmax"
            ],
            "title": "Activation",
            "type": "string"
          },
          "default": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default"
          },
          "instruction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Labels",
            "type": "array"
          },
          "max_labels": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 1,
            "title": "Max Labels"
          },
          "min_labels": {
            "default": 1,
            "minimum": 0.0,
            "title": "Min Labels",
            "type": "integer"
          },
          "ordered": {
            "default": false,
            "title": "Ordered",
            "type": "boolean"
          },
          "temperature": {
            "default": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Temperature",
            "type": "number"
          },
          "threshold": {
            "default": 0.5,
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Threshold",
            "type": "number"
          }
        },
        "required": [
          "labels"
        ],
        "title": "ClassificationTask",
        "type": "object"
      },
      "DownloadJob": {
        "additionalProperties": false,
