      },
      "DownloadRequest": {
        "additionalProperties": false,
        "properties": {
          "approved": {
            "title": "Approved",
            "type": "boolean"
          },
          "destination": {
            "minLength": 1,
            "title": "Destination",
            "type": "string"
          },
          "revision": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{40}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          }
        },
        "required": [
