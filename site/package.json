{
  "name": "@gliner-runner/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GLiNER Runner documentation site (Astro + Starlight)",
  "license": "Apache-2.0",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs && astro dev",
    "build": "node scripts/generate.mjs && astro build",
    "preview": "astro preview",
    "test": "node --test scripts/generate.test.mjs scripts/code-focus.test.mjs scripts/markdown-copies.test.mjs scripts/table-focus.test.mjs scripts/twenty-questions/game.test.mjs scripts/twenty-questions/trace.test.mjs scripts/be-the-model.test.mjs scripts/be-the-model-scores.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/starlight": "0.42.6",
    "@gliner-runner/onnx-runner-web": "workspace:*",
    "astro": "7.3.8",
    "d3-brush": "3.0.0",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
