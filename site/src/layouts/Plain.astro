---
// Layout of the pages outside the docs (the landing page and the playground): a slim header, the shared look,
// and the light or dark theme the visitor picked in the docs.
import "../styles/brand.css";

interface Props {
  title: string;
  description: string;
  current?: "playground" | undefined;
}

const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Starlight keeps the docs' theme choice here; "" or nothing means "follow the system".
      try {
        const theme = localStorage.getItem("starlight-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>GLiNER Runner</a>
      <nav aria-label="Site">
        <a href={`${base}playground/`} aria-current={current === "playground" ? "page" : undefined}>Try it</a>
        <a href={`${base}how-it-works/`}>Docs</a>
        <a href="https://github.com/stuffbucket/gliner-runner">GitHub</a>
      </nav>
    </header>
    <slot />
  </body>
</html>
