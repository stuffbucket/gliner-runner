---
import BeTheModel from "../components/BeTheModel.jsx";
import Plain from "../layouts/Plain.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Plain
  title="Be the model, be the kid · GLiNER Runner"
  description="A kid wants a later bedtime and is working out which pitch will land. Drag the model's scores and watch the pitch change."
>
  <main class="btm-page">
    <h1>Be the model, be the kid</h1>
    <p class="lead">
      You want something, say a later bedtime, and you are working out which pitch will land. Beg? Offer a deal? Ask a different
      grown-up? The model reads each line and scores every pitch. Drag a slider to change the pitch, and watch the line
      and the other scores change with it.
    </p>
    <BeTheModel client:load />
    <p class="more">
      <a href={`${base}how-it-works/#what-the-numbers-mean`}>What the numbers mean</a>
    </p>
  </main>
</Plain>

<style>
  .btm-page {
    width: min(100% - 2rem, 70rem);
    margin: 0 auto;
    padding: clamp(1.5rem, 5vw, 3rem) 0 3rem;
  }
  h1 {
    margin: 0 0 0.5rem;
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
  }
  .lead {
    max-width: 40rem;
    margin: 0 0 1.75rem;
    color: var(--muted);
    font-size: var(--text-lg);
  }
  .more {
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
</style>
