---
// A rotating card of real answers from the examples, precomputed with the models by scripts/gallery.mjs (no model
// runs on the page). Every slide is in the HTML; the script only moves between them.
import { getCollection } from "astro:content";

import gallery from "../data/gallery.json";

interface Entry {
  example: string;
  model: string;
  text: string;
  labels: string[];
  multi: boolean;
  threshold: number;
  picked: string[];
  scores: Record<string, number>;
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const titles = new Map((await getCollection("docs")).map((page) => [page.id, page.data.title]));
// Every slide shows the same number of score rows, so the card is nearly as tall on every slide and there is no
// hole under the short ones. The rest of the labels sent are counted under the rows; they all scored lower.
const ROWS = 3;
const slides = (gallery.entries as Entry[]).map((entry) => {
  const ranked = Object.entries(entry.scores).sort((a, b) => b[1] - a[1]);
  const hidden = ranked.length - ROWS;
  if (entry.picked.some((label) => !ranked.slice(0, ROWS).some(([shown]) => shown === label))) {
    throw new Error(`The gallery card "${entry.text}" picked a label below its top ${ROWS} scores`);
  }
  return {
    ...entry,
    title: titles.get(`examples/${entry.example}`) ?? "Examples",
    // Hyphens inside numbers do not break, so a phone number stays on one line.
    quote: entry.text.replace(/(\d)-(?=\d)/g, "$1\u2011"),
    shown: ranked.slice(0, ROWS),
    // The line under the rows says how many labels were sent, so the chips that used to repeat them are gone.
    sent:
      hidden > 0
        ? `+${hidden} more label${hidden === 1 ? "" : "s"} with lower scores`
        : ranked.length === 2
          ? "Both labels shown"
          : `All ${ranked.length} labels shown`,
  };
});
---

<figure class="gallery answer-card" aria-roledescription="carousel" aria-label="Examples of real answers">
  <div class="slides">
    {
      slides.map((slide, index) => (
        <div
          class="slide"
          data-active={index === 0 ? "" : undefined}
          aria-hidden={index === 0 ? undefined : "true"}
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${slides.length}`}
        >
          <p class="answer-quote">“{slide.quote}”</p>
          <div class="result">
            <ul
              class="answer-scores"
              data-threshold={slide.multi ? "" : undefined}
              style={slide.multi ? `--threshold: ${slide.threshold * 100}%` : undefined}
            >
              {slide.shown.map(([label, score]) => (
                <li class={slide.picked.includes(label) ? "picked" : ""}>
                  <span>{label}</span>
                  <span class="meter">
                    <span style={`width: ${Math.max(2, Math.round(score * 100))}%`} />
                  </span>
                  <span>{score.toFixed(2)}</span>
                </li>
              ))}
            </ul>
            <p class="sent">{slide.sent}</p>
          </div>
          <div class="source">
            <p>
              <span class="model-badge">{slide.model}</span>
              {slide.multi && <span>several labels, threshold {slide.threshold.toFixed(2)}</span>}
            </p>
            <a href={`${base}examples/${slide.example}/`} tabindex={index === 0 ? undefined : "-1"}>
              {slide.title} →
            </a>
          </div>
        </div>
      ))
    }
  </div>
  <div class="controls">
    <button type="button" data-step="-1" aria-label="Previous example">‹</button>
    <span class="dots" aria-hidden="true">
      {slides.map((_, index) => <span data-dot={index} data-active={index === 0 ? "" : undefined} />)}
    </span>
    <button type="button" data-step="1" aria-label="Next example">›</button>
  </div>
</figure>

<script>
  const gallery = document.querySelector<HTMLElement>(".gallery");
  if (gallery) {
    const slides = [...gallery.querySelectorAll<HTMLElement>(".slide")];
    const dots = [...gallery.querySelectorAll<HTMLElement>("[data-dot]")];
    let current = 0;
    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.toggleAttribute("data-active", active);
        slide.toggleAttribute("aria-hidden", !active);
        slide.querySelector("a")?.setAttribute("tabindex", active ? "0" : "-1");
        dots[index]?.toggleAttribute("data-active", active);
      });
      // The landing page's headline for each card (index.astro) follows the card.
      for (const headline of document.querySelectorAll<HTMLElement>("[data-headline]")) {
        headline.toggleAttribute("data-active", Number(headline.dataset.headline) === current);
      }
    };
    for (const button of gallery.querySelectorAll<HTMLButtonElement>("[data-step]")) {
      button.addEventListener("click", () => show(current + Number(button.dataset.step)));
    }

    // Rotates by itself unless the visitor prefers less motion, and pauses while pointed at, focused or hidden.
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let paused = false;
    const pause = (value: boolean) => () => (paused = value);
    gallery.addEventListener("pointerenter", pause(true));
    gallery.addEventListener("pointerleave", pause(false));
    gallery.addEventListener("focusin", pause(true));
    gallery.addEventListener("focusout", pause(false));
    if (!still) {
      setInterval(() => {
        if (!paused && !document.hidden) show(current + 1);
      }, 5000);
    }
  }
</script>

<style>
  /* Spacing is in multiples of --space, the same scale as the hero's left half (index.astro): blocks are 3 apart,
     score rows 1. With the card's padding also 3, the quote's top and the controls' bottom sit on the same lines
     as the top of the headline and the bottom of the buttons. */
  .gallery {
    gap: calc(var(--space) * 2);
    margin: 0;
    padding: calc(var(--space) * 3);
  }
  /* Every slide sits in the same cell, so the card is as tall as the tallest one and never jumps. The slides
     differ by at most one score row or one line of the quote, and that room is shared out above and below the
     scores, so the quote stays on the top line and the footer on the bottom one. In one column (a phone) the
     card keeps the same rule rather than fitting each slide: the points below it would otherwise move every five
     seconds, and with the slides this close in height the room it reserves stays small. */
  .slides {
    display: grid;
    flex: 1;
  }
  .slide {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: calc(var(--space) * 3);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s ease,
      visibility 0s linear 0.45s;
  }
  .slide[data-active] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.45s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide[data-active] {
      transition: none;
    }
  }
  /* Two lines at most at desktop widths; the longest quote is 83 characters. */
  .answer-quote {
    text-wrap: pretty;
  }
  .result {
    display: grid;
    gap: var(--space);
    margin-block: auto;
  }
  .answer-scores {
    row-gap: var(--space);
  }
  /* With several labels allowed, every label above the threshold is picked; a tick on each bar marks it. The
     single-label cards pick the top score whatever it is, so they have no tick. */
  .answer-scores[data-threshold] .meter {
    position: relative;
    overflow: visible;
  }
  .answer-scores[data-threshold] .meter::after {
    content: "";
    position: absolute;
    top: -0.2rem;
    bottom: -0.2rem;
    left: var(--threshold);
    width: 2px;
    margin-left: -1px;
    border-radius: 1px;
    background: var(--muted);
  }
  .sent,
  .source p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  /* The model and the example it came from, on two lines, so a long example title never wraps unevenly. */
  .source {
    display: grid;
    gap: calc(var(--space) / 2);
    justify-items: start;
    font-size: var(--text-sm);
  }
  .source p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space) calc(var(--space) * 1.5);
  }
  .source a {
    color: var(--muted);
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--space) * 1.5);
    padding-top: calc(var(--space) * 2);
    border-top: 1px solid var(--border);
  }
  .controls button {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .controls button:hover {
    color: var(--text);
  }
  .controls button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .dots {
    display: flex;
    gap: 0.35rem;
  }
  .dots span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--border);
  }
  .dots span[data-active] {
    background: var(--accent);
  }
</style>
