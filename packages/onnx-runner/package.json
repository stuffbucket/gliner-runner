{
  "name": "@gliner-runner/onnx-runner",
  "version": "0.4.0",
  "description": "Python-free ONNX runner implementing the GLiNER Runner HTTP protocol",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "gliner-runner-onnx": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./portable": {
      "types": "./dist/src/portable.d.ts",
      "browser": "./src/portable.ts",
      "default": "./dist/src/portable.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#platform": {
      "types": "./src/platform/node.ts",
      "browser": "./src/platform/slot.ts",
      "default": "./dist/src/platform/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm run build && node --test 'dist/test/**/*.test.js'"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "onnxruntime-node": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@gliner-runner/client": "workspace:*",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
