{
  "name": "@gliner-runner/client",
  "version": "0.1.0",
  "description": "Runtime-validated TypeScript client for the GLiNER Runner HTTP API",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sidecar": {
      "types": "./dist/sidecar.d.ts",
      "import": "./dist/sidecar.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm run build && node --test index.test.mjs sidecar.test.mjs"
  },
  "dependencies": {
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
